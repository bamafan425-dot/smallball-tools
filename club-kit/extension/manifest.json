{
  "manifest_version": 3,
  "name": "SmallBall Club Kit",
  "version": "1.26.0",
  "description": "Quick club tabs, a readable club selector, your own club logos, a club dashboard, stadium records, PlayerOptimizer III by Jon2s and SmallBall Radio for play.smallball.com. Read-only: it never plays, trains or saves for you.",
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://play.smallball.com/*"], "js": ["freeze.js", "po3-interceptor.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://play.smallball.com/*"], "js": ["po3-content.js", "freeze.js", "kit.js", "rotate.js"], "run_at": "document_idle" },
    { "matches": ["https://play.smallball.com/*"], "js": ["radio.js"], "run_at": "document_idle" },
    { "matches": ["https://play.smallball.com/training*"], "js": ["skins.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true }
  ]
}
